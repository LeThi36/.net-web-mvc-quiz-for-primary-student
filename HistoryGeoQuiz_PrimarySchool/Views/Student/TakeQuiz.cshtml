@model TakeQuizViewModel
@{
    ViewData["Title"] = "Làm Bài - " + Model.LessonTitle;
    
    var subjectNames = new Dictionary<string, string>
    {
        { "Toan", "Toán" },
        { "TiengViet", "Tiếng Việt" },
        { "TiengAnh", "Tiếng Anh" },
        { "TNXH", "Tự Nhiên & Xã Hội" },
        { "DaoDuc", "Đạo Đức" },
        { "TinHoc", "Tin Học" },
        { "MyThuat", "Mỹ Thuật" },
        { "KhoaHoc", "Khoa Học" },
        { "LichSu", "Lịch Sử" },
        { "DiaLy", "Địa Lý" }
    };
    
    var displayName = subjectNames.ContainsKey(Model.Subject) ? subjectNames[Model.Subject] : Model.Subject;
}

<div class="container">
    <div class="quiz-container">
        <!-- Quiz Header -->
        <div class="quiz-page-header mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary quiz-back-link">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <div class="quiz-title-content text-center">
                <h2>
                    <span class="badge bg-primary me-2">@displayName</span>
                </h2>
                <h1 class="mb-2">@Model.LessonTitle</h1>
                <p class="text-muted">Chọn đáp án đúng cho mỗi câu hỏi bên dưới</p>

                @if (Model.TimeLimitMinutes.HasValue)
                {
                    <div class="timer-badge bg-white shadow-sm border border-primary px-4 py-2 rounded-pill d-inline-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-alarm-fill text-primary"></i>
                        <span class="fw-bold text-dark">Thời gian còn lại: </span>
                        <span id="countdown" class="h4 mb-0 text-primary fw-black" data-minutes="@Model.TimeLimitMinutes">--:--</span>
                    </div>
                }
            </div>
        </div>
        
        <form asp-action="SubmitQuiz" method="post" id="quizForm">
            <input type="hidden" name="lessonId" value="@Model.LessonId" />
            <input type="hidden" name="startTime" value="@HistoryGeoQuiz_PrimarySchool.Helpers.DateTimeHelper.GetVietnamTime().ToString("O")" />
            
            @foreach (var question in Model.Questions)
            {
                <div class="question-card fade-in" style="animation-delay: @(question.QuestionNumber * 0.1)s;">
                    <div class="d-flex align-items-start mb-3">
                        <span class="question-number">@question.QuestionNumber</span>
                        <span class="question-text">@question.QuestionText</span>
                    </div>
                    
                    <div class="ps-5">
                        @foreach (var answer in question.Answers)
                        {
                            <label class="answer-option" data-question="@question.QuestionId" data-answer="@answer.AnswerId">
                                <input type="radio" name="answers[@question.QuestionId]" value="@answer.AnswerId" required />
                                <span class="answer-label">@answer.AnswerLabel</span>
                                <span class="answer-text">@answer.AnswerText</span>
                            </label>
                        }
                    </div>
                </div>
            }
            
            <!-- Submit Button -->
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-xl" id="submitBtn">
                    <i class="bi bi-send"></i> Nộp Bài
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Handle answer selection visual feedback
        document.querySelectorAll('.answer-option').forEach(option => {
            option.addEventListener('click', function() {
                const questionId = this.dataset.question;
                const radio = this.querySelector('input[type="radio"]');
                
                // Remove selected class from all options in this question
                document.querySelectorAll(`.answer-option[data-question="${questionId}"]`).forEach(opt => {
                    opt.classList.remove('selected');
                });
                
                // Add selected class to clicked option
                this.classList.add('selected');
                radio.checked = true;
            });
        });
        
        // Confirm before submit
        document.getElementById('quizForm').addEventListener('submit', function(e) {
            const totalQuestions = @Model.Questions.Count;
            const answeredQuestions = document.querySelectorAll('input[type="radio"]:checked').length;
            
            if (answeredQuestions < totalQuestions && !window.autoSubmit) {
                if (!confirm(`Bạn mới trả lời ${answeredQuestions}/${totalQuestions} câu. Bạn có muốn nộp bài không?`)) {
                    e.preventDefault();
                }
            }
        });

        // Countdown Timer Logic
        const countdownEl = document.getElementById('countdown');
        if (countdownEl) {
            let totalSeconds = parseInt(countdownEl.dataset.minutes) * 60;
            
            function updateTimer() {
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                
                countdownEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                
                if (totalSeconds <= 0) {
                    clearInterval(timerInterval);
                    window.autoSubmit = true;
                    alert('Đã hết thời gian làm bài! Hệ thống sẽ tự động nộp bài.');
                    document.getElementById('quizForm').submit();
                }
                
                if (totalSeconds < 30) {
                    countdownEl.classList.add('text-danger');
                    countdownEl.classList.remove('text-primary');
                }
                
                totalSeconds--;
            }
            
            updateTimer();
            const timerInterval = setInterval(updateTimer, 1000);
        }
    </script>
}
