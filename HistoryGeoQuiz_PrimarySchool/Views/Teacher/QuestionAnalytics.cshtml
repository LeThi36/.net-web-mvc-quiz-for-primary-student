@model QuestionAnalyticsViewModel

@{
    ViewData["Title"] = "Phân tích câu hỏi";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="mb-4">
        <div class="mb-3">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-bar-chart-line text-primary me-2"></i>
                Báo cáo: @(Model.LessonTitle)
            </h2>
            <p class="text-muted mb-0">Tổng quan kết quả học tập của lớp.</p>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <button onclick="window.print()" class="btn btn-primary px-4 rounded-pill shadow-sm">
                <i class="bi bi-printer me-1"></i> In báo cáo
            </button>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="row">
        <!-- Left Column: 2/3 Width - Question Analytics Table -->
        <div class="col-lg-8">
            <div class="card teacher-panel mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Chi tiết từng câu hỏi</h5>
                    <span class="badge bg-light text-dark border">@Model.QuestionStats.Count Câu hỏi</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4 py-3">Câu hỏi</th>
                                    <th class="text-center">Số lượt giải</th>
                                    <th class="analytics-col-rate">Tỷ lệ Đúng</th>
                                    <th class="text-center">Đánh giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.QuestionStats)
                                {
                                    var accuracyStyle = stat.AccuracyRate + "%";
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold text-dark text-truncate analytics-question" title="@stat.QuestionText">
                                                @stat.QuestionText
                                            </div>
                                        </td>
                                        <td class="text-center">@stat.TotalAttempts</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress progress-sm flex-grow-1">
                                                    <div class="progress-bar @(stat.IsHardQuestion ? "bg-danger" : "bg-success")" 
                                                         role="progressbar" style="width: @(accuracyStyle)"></div>
                                                </div>
                                                <span class="ms-2 small fw-bold">@(stat.AccuracyRate)%</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (stat.IsHardQuestion)
                                            {
                                                <span class="badge bg-danger-light text-danger rounded-pill px-3">Cần giảng lại</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-light text-success rounded-pill px-3">Đạt yêu cầu</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.QuestionStats.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">Chưa có dữ liệu thống kê.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: 1/3 Width - Summary Stats & Highlights -->
        <div class="col-lg-4">
            <!-- Summary Stats Card -->
            <div class="card teacher-panel mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Thông số tổng quát</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="stat-tile text-center">
                                <div class="text-muted small mb-1">Số lượt thi</div>
                                <div class="h4 fw-bold mb-0">@Model.TotalParticipants</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile text-center">
                                <div class="text-muted small mb-1">Điểm TB</div>
                                <div class="h4 fw-bold mb-0 text-primary">@Model.AverageScore</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="stat-tile d-flex justify-content-between align-items-center">
                                <div class="text-muted small">Thời gian làm bài TB</div>
                                <div class="fw-bold">@TimeSpan.FromSeconds(Model.AverageTimeSeconds).ToString(@"mm\:ss")</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 opacity-10">

                    <h6 class="fw-bold mb-3 small text-uppercase text-muted">Kết quả Đạt / Không đạt</h6>
                    <div class="progress progress-lg mb-2">
                        @{
                            var total = Model.PassCount + Model.FailCount;
                            var passPct = total > 0 ? (double)Model.PassCount / total * 100 : 0;
                            var failPct = total > 0 ? (double)Model.FailCount / total * 100 : 0;
                        }
                        <div class="progress-bar bg-success" style="width: @(passPct)%">Đạt (@Model.PassCount)</div>
                        <div class="progress-bar bg-danger" style="width: @(failPct)%">Trượt (@Model.FailCount)</div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Tỷ lệ đạt: @(Math.Round(passPct, 1))%</span>
                        <span>@(Math.Round(failPct, 1))%</span>
                    </div>
                </div>
            </div>

            <!-- All Students List -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Kết quả chi tiết</h5>
                    <span class="badge bg-primary rounded-pill">@Model.AllStudents.Count Bạn</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var student in Model.AllStudents)
                        {
                            <li class="list-group-item border-0 py-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm rounded-circle bg-primary-light text-primary me-3">
                                        @(student.FullName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">@student.FullName</div>
                                        <div class="text-muted small-meta">
                                            <i class="bi bi-clock me-1"></i> @TimeSpan.FromSeconds(student.TimeSeconds).ToString(@"mm\:ss")
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge @(student.Score >= 5 ? "bg-success" : "bg-danger") rounded-pill">@student.Score.ToString("0.0")</span>
                                    <a asp-action="StudentReport" asp-route-lessonId="@Model.LessonId" asp-route-studentId="@student.StudentId" 
                                       class="btn btn-sm btn-outline-primary rounded-circle" title="Xem báo cáo phụ huynh">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </div>
                            </li>
                        }
                        @if (!Model.AllStudents.Any())
                        {
                            <li class="list-group-item text-center py-4 text-muted small">Chưa có dữ liệu học sinh.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
