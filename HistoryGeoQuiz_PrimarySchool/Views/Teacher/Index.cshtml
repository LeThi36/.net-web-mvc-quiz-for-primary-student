@model List<Lesson>
@{
    ViewData["Title"] = "Quản Lý Bài Học";
    
    var subjectNames = new Dictionary<string, string>
    {
        { "Toan", "Toán" },
        { "TiengViet", "Tiếng Việt" },
        { "TiengAnh", "Tiếng Anh" },
        { "TNXH", "Tự Nhiên & Xã Hội" },
        { "DaoDuc", "Đạo Đức" },
        { "TinHoc", "Tin Học" },
        { "MyThuat", "Mỹ Thuật" },
        { "KhoaHoc", "Khoa Học" },
        { "LichSu", "Lịch Sử" },
        { "DiaLy", "Địa Lý" }
    };
    
    var subjectIcons = new Dictionary<string, string>
    {
        { "Toan", "bi-calculator" },
        { "TiengViet", "bi-book" },
        { "TiengAnh", "bi-translate" },
        { "TNXH", "bi-globe" },
        { "DaoDuc", "bi-heart" },
        { "TinHoc", "bi-laptop" },
        { "MyThuat", "bi-palette" },
        { "KhoaHoc", "bi-lightbulb" },
        { "LichSu", "bi-clock-history" },
        { "DiaLy", "bi-geo-alt" }
    };
}

<div class="container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="dashboard-title">
                    <i class="bi bi-easel me-2"></i>Xin chào, @ViewBag.UserName! 👋
                </h1>
                <p class="dashboard-subtitle mb-0">Quản lý các bài học và câu hỏi trắc nghiệm</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="MyClasses" class="btn btn-lg btn-outline-light">
                    <i class="bi bi-people"></i> Quản Lý Lớp
                </a>
                <a asp-action="CreateLesson" class="btn btn-lg" style="background: white; color: var(--primary-orange);">
                    <i class="bi bi-plus-circle"></i> Tạo Bài Học Mới
                </a>
            </div>
        </div>
    </div>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (Model != null && Model.Any())
    {
        var lessonsBySubject = Model.GroupBy(l => l.Subject).OrderBy(g => g.Key);
        
        foreach (var subjectGroup in lessonsBySubject)
        {
            var subjectKey = subjectGroup.Key;
            var displayName = subjectNames.ContainsKey(subjectKey) ? subjectNames[subjectKey] : subjectKey;
            var icon = subjectIcons.ContainsKey(subjectKey) ? subjectIcons[subjectKey] : "bi-book";
            var lessons = subjectGroup.OrderBy(l => l.LessonNumber).ToList();
            
            <section class="mb-5">
                <h2 class="section-title">
                    <i class="@icon"></i> Bài Học @displayName
                </h2>
                
                <div class="row g-4">
                    @foreach (var lesson in lessons)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card lesson-card h-100">
                                <div class="card-body">
                                    <div class="lesson-number">@lesson.LessonNumber</div>
                                    <h5 class="lesson-title">@lesson.Title</h5>
                                    @if (!string.IsNullOrEmpty(lesson.Description))
                                    {
                                        <p class="lesson-info">@lesson.Description</p>
                                    }
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="badge bg-secondary p-2">
                                            <i class="bi bi-people-fill me-1"></i>
                                            @(lesson.ClassRoom?.ClassName ?? "Chưa phân lớp")
                                        </span>
                                        <span class="text-muted small align-self-center">
                                            <i class="bi bi-question-circle me-1"></i> @lesson.Questions.Count câu
                                        </span>
                                    </div>
                                    
                                    <div class="d-flex gap-2 mt-3 flex-wrap">
                                        <a asp-action="ManageQuestions" asp-route-lessonId="@lesson.Id" 
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-list-check"></i> Câu hỏi
                                        </a>
                                        <a asp-action="EditLesson" asp-route-id="@lesson.Id" 
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="DeleteLesson" asp-route-id="@lesson.Id" method="post" 
                                              style="display:inline;" 
                                              onsubmit="return confirm('Bạn có chắc muốn xóa bài học này?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <div class="empty-state bg-white rounded-4 p-5 text-center">
            <i class="bi bi-journal-plus" style="font-size: 5rem; color: var(--primary-orange);"></i>
            <h3 class="mt-3">Chưa có bài học nào! 📚</h3>
            <p class="text-muted mb-4">Hãy bắt đầu bằng việc tạo bài học đầu tiên cho học sinh.</p>
            <a asp-action="CreateLesson" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Tạo Bài Học Đầu Tiên
            </a>
        </div>
    }
</div>
