@model CreateLessonViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Bài Học";
    var lessonId = ViewBag.LessonId;
}

<div class="container">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-pencil-square text-primary me-2"></i>
            Chỉnh Sửa Bài Học
        </h2>
        <p class="text-muted">Cập nhật thông tin tiêu đề và môn học cho bài học.</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Bài Học
                </div>
                <div class="card-body">
                    <form asp-action="EditLesson" asp-route-id="@lessonId" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Subject" class="form-label">
                                <i class="bi bi-bookmark me-1"></i>Môn học
                            </label>
                            <select asp-for="Subject" class="form-select">
                                <option value="Toan">🔢 Toán</option>
                                <option value="TiengViet">📖 Tiếng Việt</option>
                                <option value="TiengAnh">🌍 Tiếng Anh</option>
                                <option value="TNXH">🌿 TN & XH</option>
                                <option value="LichSu">📜 Lịch Sử</option>
                                <option value="DiaLy">🗺️ Địa Lý</option>
                                <option value="KhoaHoc">🔬 Khoa Học</option>
                                <option value="DaoDuc">⭐ Đạo Đức</option>
                                <option value="AmNhac">🎶 Âm Nhạc</option>
                                <option value="MyThuat">🎨 Mỹ Thuật</option>
                                <option value="TheDuc">🏃 Thể Dục</option>
                                <option value="TinHoc">💻 Tin Học</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="LessonNumber" class="form-label">
                                <i class="bi bi-123 me-1"></i>Số thứ tự bài
                            </label>
                            <input asp-for="LessonNumber" class="form-control" type="number" min="1" max="100" />
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label">
                                <i class="bi bi-card-heading me-1"></i>Tên bài học
                            </label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-card-text me-1"></i>Mô tả
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        
                        <div class="d-flex">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
