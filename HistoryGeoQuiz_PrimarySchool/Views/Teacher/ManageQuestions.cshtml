@model LessonDetailViewModel
@{
    ViewData["Title"] = "Quản Lý Câu Hỏi - " + Model.Lesson.Title;
    
    var subjectNames = new Dictionary<string, string>
    {
        { "Toan", "Toán" },
        { "TiengViet", "Tiếng Việt" },
        { "TiengAnh", "Tiếng Anh" },
        { "TNXH", "Tự Nhiên & Xã Hội" },
        { "DaoDuc", "Đạo Đức" },
        { "TinHoc", "Tin Học" },
        { "MyThuat", "Mỹ Thuật" },
        { "KhoaHoc", "Khoa Học" },
        { "LichSu", "Lịch Sử" },
        { "DiaLy", "Địa Lý" }
    };
    
    var displayName = subjectNames.ContainsKey(Model.Lesson.Subject) ? subjectNames[Model.Lesson.Subject] : Model.Lesson.Subject;
}

<div class="container">
    <div class="mb-4">
        <div class="mb-3">
            <h2 class="mb-1">
                <span class="badge bg-primary me-2">@displayName</span>
                @Model.Lesson.Title
            </h2>
            <p class="text-muted mb-0">Quản lý các câu hỏi trắc nghiệm trong bài học</p>
        </div>
        
        <div class="row g-3 mb-3 bg-white p-3 rounded-4 shadow-sm align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold">TỔNG SỐ CÂU HỎI</label>
                <div class="h4 mb-0 text-primary">@Model.Questions.Count</div>
            </div>
            <div class="col-md-9">
                <form asp-action="UpdateLessonConfig" method="post" class="row g-3 align-items-end">
                    <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                    <div class="col-sm-4">
                        <label class="form-label text-muted small fw-bold">THỜI GIAN (PHÚT)</label>
                        <div class="input-group">
                            <input type="number" name="timeLimit" value="@Model.Lesson.TimeLimitMinutes" 
                                   class="form-control" placeholder="Không giới hạn" min="1" max="180" />
                            <span class="input-group-text"><i class="bi bi-stopwatch"></i></span>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small fw-bold">ĐẠT GIỎI/XUẤT SẮC</label>
                        <div class="input-group">
                            <input type="number" name="good" value="@Model.Lesson.QuestionCountForGood" 
                                   class="form-control" placeholder="Tốt" title="Số câu đúng để đạt loại Tốt" />
                            <input type="number" name="excellent" value="@Model.Lesson.QuestionCountForExcellent" 
                                   class="form-control" placeholder="X.Sắc" title="Số câu đúng để đạt loại Xuất Sắc" />
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-save me-1"></i> Lưu cấu hình
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <div class="d-flex gap-2">
                <a asp-action="UploadQuestions" asp-route-lessonId="@Model.Lesson.Id" class="btn btn-success">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Import Excel
                </a>
                <a asp-action="CreateQuestion" asp-route-lessonId="@Model.Lesson.Id" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Thêm Câu Hỏi
                </a>
            </div>
        </div>
    </div>
    
    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData[TempDataKeys.SuccessMessage]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (Model.Questions.Any())
    {
        <div class="quiz-container">
            @foreach (var question in Model.Questions)
            {
                var qIndex = Model.Questions.IndexOf(question) + 1;
                <div class="question-card fade-in" style="animation-delay: @(qIndex * 0.1)s;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center">
                            <span class="question-number">@qIndex</span>
                            <span class="question-text mb-0">@question.QuestionText</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="EditQuestion" asp-route-id="@question.Id" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="DeleteQuestion" asp-route-id="@question.Id" method="post" 
                                  style="display:inline;" 
                                  onsubmit="return confirm('Bạn có chắc muốn xóa câu hỏi này?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <div class="ps-5">
                        @foreach (var answer in question.Answers.OrderBy(a => a.AnswerLabel))
                        {
                            <div class="answer-option @(answer.IsCorrect ? "correct" : "") mb-2" style="cursor: default;">
                                <span class="answer-label">@answer.AnswerLabel</span>
                                <span class="answer-text">@answer.AnswerText</span>
                                @if (answer.IsCorrect)
                                {
                                    <span class="ms-auto badge bg-success">
                                        <i class="bi bi-check"></i> Đáp án đúng
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state bg-white rounded-4 p-5 text-center">
            <i class="bi bi-question-circle" style="font-size: 5rem; color: var(--secondary-teal);"></i>
            <h3 class="mt-3">Chưa có câu hỏi nào! 🤔</h3>
            <p class="text-muted mb-4">Hãy thêm câu hỏi đầu tiên cho bài học này.</p>
            <a asp-action="CreateQuestion" asp-route-lessonId="@Model.Lesson.Id" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Thêm Câu Hỏi Đầu Tiên
            </a>
        </div>
    }
</div>
