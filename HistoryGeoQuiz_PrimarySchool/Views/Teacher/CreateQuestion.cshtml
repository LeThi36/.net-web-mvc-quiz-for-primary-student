@model CreateQuestionViewModel
@{
    ViewData["Title"] = "Thêm Câu Hỏi Mới";
}

<div class="container">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-plus-circle text-primary me-2"></i>
            Thêm Câu Hỏi Mới
        </h2>
        <p class="text-muted">Soạn thảo câu hỏi trắc nghiệm cho bài học @Model.LessonTitle.</p>
        <a asp-action="ManageQuestions" asp-route-lessonId="@Model.LessonId" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
            
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-plus-circle me-2"></i>Thêm Câu Hỏi Mới - @Model.LessonTitle
                </div>
                <div class="card-body">
                    <form asp-action="CreateQuestion" method="post">
                        <input type="hidden" asp-for="LessonId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="QuestionText" class="form-label">
                                <i class="bi bi-question-circle me-1"></i>Nội dung câu hỏi
                            </label>
                            <textarea asp-for="QuestionText" class="form-control" rows="3" 
                                      placeholder="Nhập nội dung câu hỏi..."></textarea>
                            <span asp-validation-for="QuestionText" class="text-danger small"></span>
                        </div>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="AnswerA" class="form-label">
                                    <span class="badge bg-secondary me-1">A</span>Đáp án A
                                </label>
                                <input asp-for="AnswerA" class="form-control" placeholder="Nhập đáp án A..." />
                                <span asp-validation-for="AnswerA" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AnswerB" class="form-label">
                                    <span class="badge bg-secondary me-1">B</span>Đáp án B
                                </label>
                                <input asp-for="AnswerB" class="form-control" placeholder="Nhập đáp án B..." />
                                <span asp-validation-for="AnswerB" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AnswerC" class="form-label">
                                    <span class="badge bg-secondary me-1">C</span>Đáp án C
                                </label>
                                <input asp-for="AnswerC" class="form-control" placeholder="Nhập đáp án C..." />
                                <span asp-validation-for="AnswerC" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AnswerD" class="form-label">
                                    <span class="badge bg-secondary me-1">D</span>Đáp án D
                                </label>
                                <input asp-for="AnswerD" class="form-control" placeholder="Nhập đáp án D..." />
                                <span asp-validation-for="AnswerD" class="text-danger small"></span>
                            </div>
                        </div>
                        
                        <div class="mb-4 p-3 bg-light rounded-3">
                            <label asp-for="CorrectAnswer" class="form-label fw-bold">
                                <i class="bi bi-check-circle-fill text-success me-1"></i>Chọn đáp án đúng:
                            </label>
                            <div class="d-flex gap-4 mt-2 flex-wrap">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CorrectAnswer" value="A" id="correctA">
                                    <label class="form-check-label" for="correctA">
                                        <span class="badge bg-primary">A</span>
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CorrectAnswer" value="B" id="correctB">
                                    <label class="form-check-label" for="correctB">
                                        <span class="badge bg-primary">B</span>
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CorrectAnswer" value="C" id="correctC">
                                    <label class="form-check-label" for="correctC">
                                        <span class="badge bg-primary">C</span>
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="CorrectAnswer" value="D" id="correctD">
                                    <label class="form-check-label" for="correctD">
                                        <span class="badge bg-primary">D</span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="CorrectAnswer" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Thêm Câu Hỏi
                            </button>
                            <a asp-action="ManageQuestions" asp-route-lessonId="@Model.LessonId" 
                               class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
