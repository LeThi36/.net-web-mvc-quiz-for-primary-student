@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-person-circle auth-icon"></i>
            <h2>Đăng Nhập</h2>
            <p>Chào mừng con quay trở lại!</p>
        </div>
        
        <div class="auth-body">
            @if (TempData[TempDataKeys.SuccessMessage] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>@TempData[TempDataKeys.SuccessMessage]
                </div>
            }
            
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">
                        <i class="bi bi-person me-1"></i>Tên đăng nhập
                    </label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-lock me-1"></i>Mật khẩu
                    </label>
                    <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                </button>
            </form>
            
            <hr class="my-4">
            
            <div class="text-center">
                <p class="mb-0">Chưa có tài khoản?</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary mt-2">
                    <i class="bi bi-person-plus"></i> Đăng Ký Ngay
                </a>
            </div>
        </div>
    </div>
</div>
