@using HistoryGeoQuiz_PrimarySchool.Enums
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-person-plus auth-icon"></i>
            <h2>Đăng Ký</h2>
            <p>Tạo tài khoản mới để bắt đầu học!</p>
        </div>
        
        <div class="auth-body">
            <form asp-action="Register" method="post" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                

                
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">
                        <i class="bi bi-person-badge me-1"></i>Họ và tên <span class="required-star">*</span>
                    </label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Gender" class="form-label">
                        <i class="bi bi-gender-ambiguous me-1"></i>Giới tính <span class="required-star">*</span>
                    </label>
                    <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                        <option value="">-- Chọn giới tính --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">
                        <i class="bi bi-person me-1"></i>Tên đăng nhập <span class="required-star">*</span>
                    </label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-lock me-1"></i>Mật khẩu <span class="required-star">*</span>
                    </label>
                    <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="bi bi-lock-fill me-1"></i>Xác nhận mật khẩu <span class="required-star">*</span>
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-person-plus"></i> Đăng Ký
                </button>
            </form>
            
            <hr class="my-4">
            
            <div class="text-center">
                <p class="mb-0">Đã có tài khoản?</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-2">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
