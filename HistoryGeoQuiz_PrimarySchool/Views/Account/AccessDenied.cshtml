@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container text-center py-5">
    <div class="result-card mx-auto" style="max-width: 500px;">
        <i class="bi bi-shield-exclamation text-danger" style="font-size: 5rem;"></i>
        <h1 class="mt-3">Không có quyền truy cập</h1>
        <p class="text-muted">Bạn không có quyền truy cập vào trang này.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg mt-3">
            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
        </a>
    </div>
</div>
