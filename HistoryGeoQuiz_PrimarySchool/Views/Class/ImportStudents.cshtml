@model ImportStudentsViewModel

@{
    ViewData["Title"] = "Import Học Sinh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-file-earmark-excel text-primary me-2"></i>
            Import Học Sinh Vào Lớp @Model.ClassName
        </h2>
        <p class="text-muted">Tải danh sách học sinh từ file Excel vào hệ thống.</p>
        <a asp-action="Details" asp-route-id="@Model.ClassRoomId" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card teacher-panel">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-excel"></i> 
                        Import Học Sinh Vào Lớp @Model.ClassName
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Lưu ý:</strong> Vui lòng tải file mẫu và nhập dữ liệu theo đúng định dạng trước khi tải lên. Mỗi học sinh sẽ được tạo tài khoản tự động và gán vào lớp này.
                    </div>

                    <!-- Upload Section -->
                    <form asp-action="ImportStudents" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ClassRoomId" />
                        <input type="hidden" asp-for="ClassName" />

                        <div class="mb-4">
                            <label asp-for="ExcelFile" class="form-label">
                                <strong>Bước 2:</strong> Chọn file Excel đã điền thông tin <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ExcelFile" type="file" class="form-control form-control-lg" accept=".xlsx" />
                            <span asp-validation-for="ExcelFile" class="text-danger small"></span>
                            <div class="form-text">Chỉ hỗ trợ file Excel (.xlsx)</div>
                        </div>

                        <div class="d-flex justify-content-end align-items-center mt-4">
                            <div>
                                <a asp-action="DownloadStudentTemplate" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-download"></i> Tải File mẫu Excel
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-upload"></i> Tải Lên & Xử Lý
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Instructions Card -->
            <div class="card mt-3 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Hướng Dẫn</h6>
                </div>
                <div class="card-body">
                    <h6>Cấu trúc file Excel:</h6>
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Cột A</th>
                                <th>Cột B</th>
                                <th>Cột C</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Họ và tên</strong></td>
                                <td><strong>Tên đăng nhập</strong></td>
                                <td><strong>Mật khẩu</strong></td>
                            </tr>
                            <tr class="text-muted">
                                <td>Nguyễn Văn A</td>
                                <td>nguyenvana</td>
                                <td>123456</td>
                            </tr>
                        </tbody>
                    </table>
                    <ul class="mb-0 small">
                        <li>Dòng đầu tiên là tiêu đề, dữ liệu bắt đầu từ dòng 2</li>
                        <li>Tên đăng nhập không được trùng với tài khoản đã có</li>
                        <li><strong>Trường hợp trùng họ tên:</strong> Hãy đặt <strong><em>Tên đăng nhập</em></strong> khác nhau (VD: nguyenvana1, nguyenvana2...) để phân biệt</li>
                        <li>Mỗi học sinh sẽ được tạo tài khoản tự động</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
