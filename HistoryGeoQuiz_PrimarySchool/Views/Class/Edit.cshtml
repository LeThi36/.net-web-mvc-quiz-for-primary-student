@model HistoryGeoQuiz_PrimarySchool.Models.ClassRoom

@{
    ViewData["Title"] = "Chỉnh Sửa Lớp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-pencil-square text-primary me-2"></i>
            Chỉnh Sửa Lớp
        </h2>
        <p class="text-muted">Cập nhật thông tin chi tiết cho lớp @Model.ClassName.</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">✏️ Chỉnh Sửa Lớp @Model.ClassName</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="ClassName" class="form-label control-label fw-bold"></label>
                            <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: 1/1, 5/2..." />
                            <span asp-validation-for="ClassName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Grade" class="form-label control-label fw-bold"></label>
                            <select asp-for="Grade" class="form-select">
                                <option value="1">Khối 1</option>
                                <option value="2">Khối 2</option>
                                <option value="3">Khối 3</option>
                                <option value="4">Khối 4</option>
                                <option value="5">Khối 5</option>
                            </select>
                            <span asp-validation-for="Grade" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HomeroomTeacherId" class="form-label control-label fw-bold">Giáo Viên Chủ Nhiệm</label>
                            <select asp-for="HomeroomTeacherId" class="form-select" asp-items="ViewBag.TeacherList">
                                <option value="">-- Chọn Giáo Viên --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-warning">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
