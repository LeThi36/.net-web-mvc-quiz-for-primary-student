@model HistoryGeoQuiz_PrimarySchool.Models.ClassRoom

@{
    ViewData["Title"] = "Chi tiết Lớp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <!-- Class Info -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Thông Tin Lớp @Model.ClassName</h5>
                </div>
                <div class="card-body">
                    <h2 class="text-center text-primary fw-bold display-4">@Model.ClassName</h2>
                    <hr />
                    <p><strong>Khối:</strong> <span class="badge bg-secondary fs-6">Khối @Model.Grade</span></p>
                    <p><strong>Sĩ số:</strong> @Model.Students.Count học sinh</p>
                    <p><strong>GVCN:</strong> @(Model.HomeroomTeacher?.FullName ?? "Chưa phân công")</p>
                    <div class="d-grid gap-2 mt-4">
                         <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">Chỉnh sửa thông tin</a>
                         <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignments & Students -->
        <div class="col-md-8">
            <!-- Teachers Assignments (Admin Only) -->
            @if (ViewBag.IsAdmin == true)
            {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-person-video3"></i> Phân Công Giáo Viên</h5>
                    <button class="btn btn-sm btn-light text-success fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#assignForm">
                        + Phân công
                    </button>
                </div>
                <div class="card-body">
                    
                    <!-- Assign Form -->
                    <div class="collapse mb-3" id="assignForm">
                        <div class="card card-body bg-light">
                            <form asp-action="AssignTeacher" method="post" class="row g-3 align-items-end">
                                <input type="hidden" name="classRoomId" value="@Model.Id" />
                                <div class="col-md-5">
                                    <label class="form-label small">Giáo Viên</label>
                                    <select name="teacherId" class="form-select" asp-items="ViewBag.Teachers" required>
                                        <option value="">-- Chọn Giáo Viên --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Môn Dạy</label>
                                    <select name="subject" class="form-select">
                                        <option value="Toan">🔢 Toán</option>
                                        <option value="TiengViet">📚 Tiếng Việt</option>
                                        <option value="TiengAnh">🌎 Tiếng Anh</option>
                                        <option value="TNXH">🌿 TN & XH</option>
                                        <option value="LichSu">📜 Lịch Sử</option>
                                        <option value="DiaLy">🗺️ Địa Lý</option>
                                        <option value="KhoaHoc">🔬 Khoa Học</option>
                                        <option value="DaoDuc">⭐ Đạo Đức</option>
                                        <option value="AmNhac">🎵 Âm Nhạc</option>
                                        <option value="MyThuat">🎨 Mỹ Thuật</option>
                                        <option value="TheDuc">⚽ Thể Dục</option>
                                        <option value="TinHoc">💻 Tin Học</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-success w-100">Lưu</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    @if (Model.TeacherAssignments.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Giáo Viên</th>
                                    <th>Môn Dạy</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assign in Model.TeacherAssignments)
                                {
                                    <tr>
                                        <td>@assign.Teacher.FullName</td>
                                        <td>
                                            @{
                                                var subjectName = assign.Subject switch {
                                                    "Toan" => "🔢 Toán",
                                                    "TiengViet" => "📚 Tiếng Việt",
                                                    "TiengAnh" => "🌎 Tiếng Anh",
                                                    "TNXH" => "🌿 TN & XH",
                                                    "LichSu" => "📜 Lịch Sử",
                                                    "DiaLy" => "🗺️ Địa Lý",
                                                    "KhoaHoc" => "🔬 Khoa Học",
                                                    "DaoDuc" => "⭐ Đạo Đức",
                                                    "AmNhac" => "🎵 Âm Nhạc",
                                                    "MyThuat" => "🎨 Mỹ Thuật",
                                                    "TheDuc" => "⚽ Thể Dục",
                                                    "TinHoc" => "💻 Tin Học",
                                                    _ => assign.Subject
                                                };
                                            }
                                            <span class="badge bg-secondary">@subjectName</span>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="RemoveAssignment" method="post" class="d-inline">
                                                <input type="hidden" name="assignmentId" value="@assign.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa phân công này?');">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Chưa có giáo viên bộ môn nào được phân công.</p>
                    }
                </div>
            </div>
            }

            <!-- Student List -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Danh Sách Học Sinh (@Model.Students.Count)</h5>
                    <div class="d-flex gap-1 flex-wrap">
                        <a asp-action="AssignExistingStudent" asp-route-id="@Model.Id" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-person-check"></i> HS có sẵn
                        </a>
                        <a asp-action="AddStudent" asp-route-id="@Model.Id" class="btn btn-sm btn-light text-primary fw-bold">
                            <i class="bi bi-person-plus"></i> Thêm mới
                        </a>
                        <a asp-action="ImportStudents" asp-route-id="@Model.Id" class="btn btn-sm btn-success">
                            <i class="bi bi-file-earmark-excel"></i> Import
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Họ Tên</th>
                                        <th>Username</th>
                                        <th class="text-end" style="width: 180px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var stt = 1; }
                                    @foreach (var student in Model.Students.OrderBy(s => s.FullName))
                                    {
                                        <tr>
                                            <td>@stt</td>
                                            <td>
                                                <i class="bi bi-person-fill text-primary"></i>
                                                @student.FullName
                                            </td>
                                            <td><code>@student.Username</code></td>
                                            <td class="text-end">
                                                <a asp-action="TransferStudent" asp-route-id="@student.Id" 
                                                   class="btn btn-sm btn-outline-warning" title="Chuyển lớp">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                </a>
                                                <form asp-action="RemoveStudent" method="post" class="d-inline">
                                                    <input type="hidden" name="classRoomId" value="@Model.Id" />
                                                    <input type="hidden" name="studentId" value="@student.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            onclick="return confirm('Xóa học sinh @student.FullName khỏi lớp?');"
                                                            title="Xóa khỏi lớp">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">Chưa có học sinh trong lớp</p>
                            <a asp-action="AddStudent" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="bi bi-person-plus"></i> Thêm Học Sinh Đầu Tiên
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

