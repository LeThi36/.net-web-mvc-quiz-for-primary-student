@model CreateTeacherViewModel

@{
    ViewData["Title"] = "Thêm Giáo viên mới";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-person-plus text-primary me-2"></i>
            Thêm Giáo viên mới
        </h2>
        <p class="text-muted">Tạo tài khoản mới cho giáo viên trong hệ thống.</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card teacher-panel">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-plus-fill"></i> Thêm Giáo Viên Mới</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTeacher" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Họ và tên</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-at"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." type="password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Xác nhận mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Xác nhận lại mật khẩu..." type="password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Gender" class="form-label fw-bold">Giới tính</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gender-ambiguous"></i></span>
                                <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                    <option value="">-- Chọn giới tính --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Thêm Mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
