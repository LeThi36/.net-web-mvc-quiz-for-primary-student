@model ImportTeachersResultViewModel

@{
    ViewData["Title"] = "Kết Quả Import Giáo Viên";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-bar-chart text-primary me-2"></i>
            Kết Quả Import Giáo Viên
        </h2>
        <p class="text-muted">Báo cáo chi tiết về quá trình xử lý file Excel.</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách Giáo viên
        </a>
    </div>
    <div class="card teacher-panel">
        <div class="card-header bg-white">
            <h4 class="mb-0 text-primary">
                <i class="bi bi-bar-chart-fill"></i> Kết Quả Import
            </h4>
        </div>
        <div class="card-body">
            <div class="row text-center mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border">
                        <h2 class="text-secondary">@Model.TotalRows</h2>
                        <span class="text-muted">Tổng số dòng</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-success bg-opacity-10 rounded border border-success">
                        <h2 class="text-success">@Model.SuccessCount</h2>
                        <span class="text-success">Thành công</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-danger bg-opacity-10 rounded border border-danger">
                        <h2 class="text-danger">@Model.ErrorCount</h2>
                        <span class="text-danger">Lỗi</span>
                    </div>
                </div>
            </div>

            @if (Model.Errors.Any())
            {
                <h5 class="text-danger mt-4"><i class="bi bi-exclamation-triangle"></i> Chi tiết lỗi</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="table-danger">
                            <tr>
                                <th>Dòng</th>
                                <th>Họ Tên</th>
                                <th>Tên Đăng Nhập</th>
                                <th>Chi tiết lỗi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.Errors)
                            {
                                <tr>
                                    <td>@error.RowNumber</td>
                                    <td>@error.FullName</td>
                                    <td>@error.Username</td>
                                    <td><span class="text-danger">@error.ErrorMessage</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.SuccessfulTeachers.Any())
            {
                <h5 class="text-success mt-4"><i class="bi bi-check-circle"></i> Danh sách thành công</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead class="table-success">
                            <tr>
                                <th>Họ Tên</th>
                                <th>Tên Đăng Nhập</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var success in Model.SuccessfulTeachers)
                            {
                                <tr>
                                    <td>@success.FullName</td>
                                    <td>@success.Username</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
