@model HistoryGeoQuiz_PrimarySchool.ViewModels.ImportTeachersViewModel

@{
    ViewData["Title"] = "Import Danh sách Giáo viên";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-file-earmark-excel text-primary me-2"></i>
            Nhập Danh Sách Giáo Viên
        </h2>
        <p class="text-muted">Import dữ liệu giáo viên từ file Excel (.xlsx).</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card teacher-panel">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-excel"></i> Nhập Danh Sách Giáo Viên
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Lưu ý:</strong> Vui lòng tải file mẫu và nhập dữ liệu theo đúng định dạng trước khi tải lên. Các giáo viên được tạo sẽ có quyền quản lý bài học và lớp học được gán.
                    </div>

                    <form asp-action="ImportTeachers" enctype="multipart/form-data" method="post">
                        <div class="mb-4">
                            <label asp-for="ExcelFile" class="form-label fw-bold"></label>
                            <input asp-for="ExcelFile" class="form-control" type="file" accept=".xlsx" />
                            <span asp-validation-for="ExcelFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end align-items-center mt-4">
                            <div>
                                <a asp-action="DownloadTeacherTemplate" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-download"></i> Tải File Mẫu
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-upload"></i> Tải Lên & Xử Lý
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Instructions Card -->
    <div class="row justify-content-center mt-3">
        <div class="col-md-8">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Hướng Dẫn</h6>
                </div>
                <div class="card-body">
                    <h6>Cấu trúc file Excel:</h6>
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Cột A</th>
                                <th>Cột B</th>
                                <th>Cột C</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Họ và tên</strong></td>
                                <td><strong>Tên đăng nhập</strong></td>
                                <td><strong>Mật khẩu</strong></td>
                            </tr>
                        </tbody>
                    </table>
                    <ul class="mb-0 small">
                        <li>Dòng đầu tiên là tiêu đề, dữ liệu bắt đầu từ dòng 2</li>
                        <li>Tên đăng nhập không được trùng với tài khoản đã có</li>
                        <li><strong>Trường hợp trùng họ tên:</strong> Hãy đặt <em>Tên đăng nhập</em> khác nhau (VD: gv_nguyenvana1, gv_nguyenvana2...) để phân biệt</li>
                        <li>Mỗi giáo viên sẽ được tạo tài khoản tự động với quyền quản lý</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
