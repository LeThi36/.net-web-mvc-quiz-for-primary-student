@model IEnumerable<HistoryGeoQuiz_PrimarySchool.Models.User>

@{
    ViewData["Title"] = "Quản lý Giáo Viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill text-primary me-2"></i> Danh sách Giáo viên</h2>
        <div>
            <a asp-action="CreateTeacher" class="btn btn-primary me-2">
                <i class="bi bi-plus-lg"></i> Thêm Giáo Viên
            </a>
            <a asp-action="ImportTeachers" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Import từ Excel
            </a>
        </div>
    </div>

    @if (TempData[HistoryGeoQuiz_PrimarySchool.Constants.TempDataKeys.SuccessMessage] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData[HistoryGeoQuiz_PrimarySchool.Constants.TempDataKeys.SuccessMessage]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card teacher-panel">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Họ và Tên</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Vai Trò</th>
                            <th>Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr>
                                <td>@teacher.FullName</td>
                                <td><span class="badge bg-secondary">@teacher.Username</span></td>
                                <td><span class="badge bg-primary">Giáo viên</span></td>
                                <td>@teacher.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có giáo viên nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
