@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="container py-5">
    <div class="error-wrapper mx-auto" style="max-width: 800px;">
        <div class="error-card text-center p-5 shadow-lg border-0 rounded-4 bg-white">
            <div class="error-icon-container mb-4">
                @if (Model.StatusCode == "404")
                {
                    <i class="bi bi-search-heart text-info display-1 animate__animated animate__bounceIn"></i>
                }
                else if (Model.StatusCode == "403")
                {
                    <i class="bi bi-shield-lock text-danger display-1 animate__animated animate__shakeX"></i>
                }
                else
                {
                    <i class="bi bi-exclamation-octagon text-warning display-1 animate__animated animate__pulse animate__infinite"></i>
                }
            </div>

            <h1 class="display-4 fw-bold text-dark mb-3">
                @(Model.StatusCode == "404" ? "Không tìm thấy trang" : "Oops! Có lỗi rồi")
            </h1>
            
            <p class="lead text-muted mb-4">
                @Model.Message
            </p>

            <div class="d-flex justify-content-center gap-3 mb-5">
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow">
                    <i class="bi bi-house-heart me-2"></i>Về trang chủ
                </a>
            </div>

            @if (Model.IsDevelopment)
            {
                <div class="mt-5 text-start">
                    <div class="card border-danger bg-light">
                        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="bi bi-bug me-2"></i>Thông tin kỹ thuật (Chỉ dành cho Dev)</span>
                            <span class="badge bg-white text-danger">Mã lỗi: @Model.StatusCode</span>
                        </div>
                        <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                            <p><strong>Đường dẫn:</strong> <code class="text-danger">@Model.Path</code></p>
                            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
                            
                            @if (!string.IsNullOrEmpty(Model.StackTrace))
                            {
                                <hr />
                                <h6 class="fw-bold">Chi tiết lỗi:</h6>
                                <pre class="p-3 bg-dark text-success rounded-3 small">@Model.StackTrace</pre>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-4 pt-4 border-top">
                    <small class="text-muted">
                        Nếu con vẫn gặp lỗi này, hãy nhờ thầy cô hoặc ba mẹ báo lại mã ID này nhé: 
                        <span class="badge bg-light text-dark border">@Model.RequestId</span>
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .error-card {
        transition: transform 0.3s ease;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
    }
    .error-card:hover {
        transform: translateY(-5px);
    }
    .btn-primary {
        background: linear-gradient(45deg, #FF6B6B, #FF8E53);
        border: none;
    }
    .btn-primary:hover {
        background: linear-gradient(45deg, #EE5253, #FF6B6B);
        transform: scale(1.05);
    }
</style>
