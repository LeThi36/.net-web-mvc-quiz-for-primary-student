<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học Tập Tiểu Học</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-mortarboard me-2"></i>
                Học Tập Tiểu Học
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString(SessionKeys.UserId) != null)
                    {
                        var role = Context.Session.GetString(SessionKeys.UserRole);
                        var userName = Context.Session.GetString(SessionKeys.UserName);
                        
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profile" asp-action="Index" title="Trang cá nhân">
                                <i class="bi bi-person-circle me-1"></i>
                                Xin chào, @userName!
                            </a>
                        </li>
                        
                        @if (role == nameof(HistoryGeoQuiz_PrimarySchool.Enums.UserRole.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Class" asp-action="Index">
                                    <i class="bi bi-gear me-1"></i>Quản lý Lớp
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-person-lines-fill me-1"></i>Quản lý Giáo Viên
                                </a>
                            </li>
                        }
                        else if (role == nameof(HistoryGeoQuiz_PrimarySchool.Enums.UserRole.Teacher))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="Index">
                                    <i class="bi bi-house-heart me-1"></i>Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Index">
                                    <i class="bi bi-house-heart me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="History">
                                    <i class="bi bi-clock-history me-1"></i>Lịch sử
                                </a>
                            </li>
                        }
                        
                        <li class="nav-item">
                            @* [S12] FIX: Logout must be POST to prevent CSRF *@
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn-logout border-0 bg-transparent">
                                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-register" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">
            <div class="footer-icons">
                <i class="bi bi-book"></i>
                <i class="bi bi-calculator"></i>
                <i class="bi bi-mortarboard"></i>
            </div>
            <p class="mb-0">Học Tập Tiểu Học - Dành cho học sinh tiểu học</p>
            <p class="small">© 2026 - Học vui, hiểu sâu! 📚</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
